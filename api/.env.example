# Подключение к Postgres. Локально — см. README (brew). На хостинге
# переменная обычно подставляется сама при добавлении Postgres к проекту.
DATABASE_URL="postgresql://beauty:beauty@localhost:5432/beauty_crm?schema=public"

# Токен бота мастеров из @BotFather — отдельный бот, не бот репетиторов.
# Им же проверяется подпись initData, поэтому без него API не поднимется.
BOT_TOKEN=""

# Имя бота без @ — для ссылок-приглашений клиенткам.
BOT_USERNAME="your_beauty_bot"

# Секрет подписи JWT. Сгенерировать: openssl rand -base64 32
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Origin мини-аппа для CORS. Несколько — через запятую.
CORS_ORIGINS="http://localhost:5174"

PORT=3000
# Сколько прокси стоит перед API на хостинге (обычно 1). Локально — не задавать.
TRUST_PROXY=
NODE_ENV=development

# Режим бота: polling — локально с работающим ботом, webhook — прод,
# off — бот не подключается к Telegram и никому не пишет (разработка интерфейса).
BOT_MODE="polling"

# Только для webhook: публичный адрес API, например https://api.example.com.
# Telegram будет слать обновления на <BOT_PUBLIC_URL>/api/bot/webhook
BOT_PUBLIC_URL=""
# Только для webhook: секрет в заголовке X-Telegram-Bot-Api-Secret-Token.
# Сгенерировать: openssl rand -hex 32
BOT_WEBHOOK_SECRET=""

# Адрес мини-аппа (https://…): по нему бот показывает мастеру кнопку
# «Открыть кабинет» в ответ на /start. Пусто — бот отправит к кнопке меню.
MINI_APP_URL=""
