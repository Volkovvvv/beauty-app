# Только для `npm run dev` — в сборку не попадает.
# Фронт ходит в локальный API (api/: npm run start:dev).
VITE_API_URL=http://localhost:3002/api

# Тестовый мастер для входа без Telegram (см. tools/vite-dev-telegram-login.ts).
# Свои значения — в .env.development.local, он не коммитится.
DEV_TG_USER_ID=100000001
DEV_TG_FIRST_NAME=Вика
DEV_TG_USERNAME=dev_master
